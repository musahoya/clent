# ==========================================
# 뉴스 자동화 파이프라인 환경 변수
# ==========================================

# 뉴스 수집 키워드 (쉼표로 구분)
NEWS_KEYWORDS=AI,삼성,경제,부동산,쿠팡

# ==========================================
# AI 서비스 설정 (대본 작성용)
# ==========================================

# 사용할 AI 서비스: openai, gemini, anthropic
AI_SERVICE=openai

# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Google Gemini API 키 (https://makersuite.google.com/app/apikey)
# GEMINI_API_KEY=...

# Anthropic Claude API 키 (https://console.anthropic.com/)
# ANTHROPIC_API_KEY=...

# ==========================================
# TTS (음성 변환) 서비스 설정
# ==========================================

# 사용할 TTS 서비스: elevenlabs, google, azure
TTS_SERVICE=elevenlabs

# ElevenLabs API 키 (https://elevenlabs.io) - 추천!
ELEVENLABS_API_KEY=...

# Google Cloud TTS (서비스 계정 JSON 파일 경로)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Azure TTS
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=...

# ==========================================
# YouTube API (선택 사항)
# ==========================================

# YouTube 자격증명 파일 경로
YOUTUBE_CREDENTIALS_FILE=client_secrets.json

# ==========================================
# 기타 설정
# ==========================================

# 하루 제작할 영상 개수
TARGET_VIDEOS_PER_DAY=3

# 출력 디렉토리
OUTPUT_DIR=output
